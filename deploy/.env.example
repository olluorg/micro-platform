# Reference only — the real /opt/ollu/.env is rendered on the VPS by the deploy
# workflow from GitHub Variables/Secrets (see deploy/README.md). Don't place this
# file on the VPS by hand.
#
# OLLU_IMAGE  — pinned GHCR tag, injected per-deploy from the build job output.
# GOOGLE_AUDIENCES — GitHub Variable: comma-separated Google OAuth client_id(s)
#                    used to validate id_token audience.
# RUST_LOG    — GitHub Variable (tracing EnvFilter syntax); defaults to info.
OLLU_IMAGE=ghcr.io/<owner>/ollu-server:server-v0.1.0
GOOGLE_AUDIENCES=your-client-id.apps.googleusercontent.com
RUST_LOG=info
